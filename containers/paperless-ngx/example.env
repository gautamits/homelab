# ==============================================================================
# PAPERLESS-NGX CONFIGURATION ENVIRONMENT VARIABLES
# ==============================================================================

# Database Credentials
DB_USER=paperless
DB_PASSWORD=UseAStrongPasswordHere123!
DB_NAME=paperless

# Security Settings
# Generate a strong key (e.g., using: openssl rand -base64 36)
PAPERLESS_SECRET_KEY=ChangeMeToALongRandomStringForSecurity Purp0s3s!

# Localization and OCR Configuration
USER_TZ=Asia/Kolkata
PAPERLESS_OCR_LANGUAGE=eng

# Network Settings
PAPERLESS_PORT=8000
PAPERLESS_URL=http://localhost:8000

# Folder paths on the host system (relative to the compose file)

DATA_DIR=./data
MEDIA_DIR=./media
EXPORT_DIR=./export
CONSUME_DIR=./consume
DB_DIR=./db
REDIS_DIR=./redis
